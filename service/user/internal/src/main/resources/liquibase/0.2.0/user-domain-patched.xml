<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd"
        logicalFilePath="KapuaDB/changelog-user-0.2.0-patched.xml">

    <property name="selectUserDomainQuery" value="(SELECT id FROM athz_domain WHERE name = 'user')"/>

    <include relativeToChangelogFile="true" file="../common-properties.xml"/>

    <changeSet id="changelog-user-domain-0.2.0-patched" author="eurotech">

        <preConditions onFail="CONTINUE">
            <and>
                <tableExists tableName="athz_domain"/>
                <tableExists tableName="athz_domain_actions"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM athz_domain WHERE name='user';
                </sqlCheck>
            </and>
        </preConditions>

        <!-- Seed values -->
        <insert tableName="athz_domain">
            <column name="created_on" valueComputed="${now}"/>
            <column name="created_by" value="1"/>
            <column name="name" value="user"/>
            <column name="serviceName" value="userService"/>
        </insert>

        <insert tableName="athz_domain_actions">
            <column name="domain_id" valueComputed="${selectUserDomainQuery}"/>
            <column name="action" value="read"/>
        </insert>
        <insert tableName="athz_domain_actions">
            <column name="domain_id" valueComputed="${selectUserDomainQuery}"/>
            <column name="action" value="write"/>
        </insert>
        <insert tableName="athz_domain_actions">
            <column name="domain_id" valueComputed="${selectUserDomainQuery}"/>
            <column name="action" value="delete"/>
        </insert>

    </changeSet>

</databaseChangeLog>
