<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.kapua</groupId>
        <artifactId>kapua</artifactId>
        <version>2.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kapua-assembly</artifactId>
    <name>${project.artifactId}</name>
    <packaging>pom</packaging>

    <properties>
        <docker.account>eclipsekapua</docker.account>
        <docker.image.name>image-name</docker.image.name>

        <!-- For regular development do not create and push additional tags -->
        <docker.push.latest.skip>true</docker.push.latest.skip>
        <docker.tag.major.skip>true</docker.tag.major.skip>
        <docker.push.major.skip>true</docker.push.major.skip>
        <docker.tag.minor.skip>true</docker.tag.minor.skip>
        <docker.push.minor.skip>true</docker.push.minor.skip>
    </properties>

    <modules>
        <module>java-base</module>
        <module>jetty-base</module>
        <module>sql</module>

        <module>events-broker</module>

        <module>broker-artemis</module>
        <module>service</module>
        <module>consumer</module>

        <module>api</module>
        <module>job-engine</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.eclipse.kapua</groupId>
                <artifactId>kapua-assembly-java-base</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>

            <dependency>
                <groupId>org.apache.activemq</groupId>
                <artifactId>apache-activemq</artifactId>
                <classifier>bin</classifier>
                <type>tar.gz</type>
                <version>${activemq.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- Profile used to exclude console module on release process -->
        <profile>
            <id>console</id>
            <modules>
                <module>console</module>
            </modules>
        </profile>

        <profile>
            <id>docker</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>release</id>
            <properties>
                <!-- For releases create and push additional tags -->
                <!-- latest is not pushed until actual 2.x release -->
                <docker.push.latest.skip>true</docker.push.latest.skip>
                <docker.tag.major.skip>false</docker.tag.major.skip>
                <docker.push.major.skip>false</docker.push.major.skip>
                <docker.tag.minor.skip>false</docker.tag.minor.skip>
                <docker.push.minor.skip>false</docker.push.minor.skip>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <excludeArtifacts>${project.artifactId}</excludeArtifacts>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <!--
                            This makes following properties to be used in later steps (i.e: from 1.3.0-SNAPSHOT)
                            - project.version.majorVersion = 1
                            - project.version.minorVersion = 3
                            -->
                            <id>Parse project version</id>
                            <goals>
                                <goal>parse-version</goal>
                            </goals>
                            <configuration>
                                <!-- For some reason default format is %02d which makes version as double digits, which means it prepends a '0' for single digit version number-->
                                <formatMajor>%d</formatMajor>
                                <formatMinor>%d</formatMinor>
                                <formattedPropertyPrefix>project.version</formattedPropertyPrefix>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>io.fabric8</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <configuration>
                        <images>
                            <image>
                                <name>${docker.account}/${docker.image.name}</name>

                                <build>
                                    <dockerFile>${project.basedir}/docker/Dockerfile</dockerFile>
                                    <filter>@</filter>

                                    <tags>
                                        <tag>${project.version}</tag>
                                        <tag>latest</tag>
                                    </tags>
                                </build>
                            </image>
                        </images>
                    </configuration>
                    <executions>
                        <execution>
                            <id>Build Docker Container</id>
                            <phase>install</phase>
                            <goals>
                                <goal>build</goal>
                            </goals>
                        </execution>

                        <execution>
                            <id>Tag Docker Container - Major</id>
                            <phase>install</phase>
                            <goals>
                                <goal>tag</goal>
                            </goals>
                            <configuration>
                                <skipTag>${docker.tag.major.skip}</skipTag>
                                <tagName>${project.version.majorVersion}</tagName>
                            </configuration>
                        </execution>
                        <execution>
                            <id>Tag Docker Container - Minor</id>
                            <phase>install</phase>
                            <goals>
                                <goal>tag</goal>
                            </goals>
                            <configuration>
                                <skipTag>${docker.tag.minor.skip}</skipTag>
                                <tagName>${project.version.majorVersion}.${project.version.minorVersion}</tagName>
                            </configuration>
                        </execution>

                        <execution>
                            <id>Push Docker Containers</id>
                            <phase>deploy</phase>
                            <goals>
                                <goal>push</goal>
                            </goals>
                            <configuration>
                                <images>
                                    <image>
                                        <name>${docker.account}/${docker.image.name}:${project.version}</name>
                                        <build>
                                            <skipPush>false</skipPush>
                                        </build>
                                    </image>
                                    <image>
                                        <name>${docker.account}/${docker.image.name}:latest</name>
                                        <build>
                                            <skipPush>${docker.push.latest.skip}</skipPush>
                                        </build>
                                    </image>
                                    <image>
                                        <name>${docker.account}/${docker.image.name}:${project.version.majorVersion}</name>
                                        <build>
                                            <skipPush>${docker.push.major.skip}</skipPush>
                                        </build>
                                    </image>
                                    <image>
                                        <name>${docker.account}/${docker.image.name}:${project.version.majorVersion}.${project.version.minorVersion}</name>
                                        <build>
                                            <skipPush>${docker.push.minor.skip}</skipPush>
                                        </build>
                                    </image>
                                </images>

                                <authConfig>
                                    <username>${env.DOCKER_USERNAME}</username>
                                    <password>${env.DOCKER_TOKEN}</password>
                                </authConfig>
                            </configuration>
                        </execution>

                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
